{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "cron/Dockerfile",
    "watchPatterns": ["cron/**", "pipeline/pyproject.toml", "pipeline/uv.lock"]
  },
  "deploy": {
    "cronSchedule": "0 9 * * 1",
    "restartPolicyType": "NEVER"
  }
}
